# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored and never committed.

# Canonical production URL — used for metadata, sitemap.xml, robots.txt,
# canonical tags, and JSON-LD. Set this on Vercel for production.
NEXT_PUBLIC_SITE_URL=https://www.koiden.example

# Where bulk enquiry submissions are emailed / forwarded.
# The API route at src/app/api/enquiry/route.ts reads this.
ENQUIRY_NOTIFICATION_EMAIL=

# Optional: a webhook (e.g. Slack, Zapier, or your CRM intake URL).
# If set, each enquiry is POSTed here as JSON. Leave blank to disable.
ENQUIRY_WEBHOOK_URL=
